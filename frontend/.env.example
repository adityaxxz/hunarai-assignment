# Copy to frontend/.env.local and fill in. Never commit the filled-in file.

# Base URL of our FastAPI backend. The browser talks only to this, never to
# Hunar directly, which is what keeps the Hunar API key off the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# NOTE: anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and
# is readable by anyone who opens the site. No secret, key or token ever belongs
# in one. This file should stay a single-entry file; if a second variable is
# ever needed here, that is worth a second look.
