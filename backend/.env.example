# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Core ---
# Neon pooled connection string (Singapore region).
DATABASE_URL=postgresql+asyncpg://user:password@host-pooler.region.aws.neon.tech/dbname
# Origin allowed by CORS. The deployed Vercel URL, never "*".
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of this backend. Used to build the Hunar webhook callback URLs.
PUBLIC_BASE_URL=http://localhost:8000

# --- Demo mode ---
# true  -> VoiceProvider is HunarSimulator, no real calls, no real API key needed.
# false -> VoiceProvider is HunarClient and real phone calls cost real money.
DEMO_MODE=true

# --- Hunar Voice API ---
# Verifies inbound webhooks when DEMO_MODE=false. With DEMO_MODE=false and this
# empty, the webhook endpoint returns 503 rather than trusting an HMAC keyed on
# an empty string.
HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1

# Signing key used ONLY in demo mode, by the simulator, for its synthetic
# webhooks. We generate this; it is not issued by Hunar and has no relationship
# to any Hunar credential. Leave it blank and a random one is generated per
# process, which is fine for a single instance. Set it to any random string if
# you want it stable across restarts.
DEMO_WEBHOOK_SIGNING_KEY=

# --- Access gates ---
# Bearer token required by /internal/* (cron endpoints).
INTERNAL_API_TOKEN=
# Shared secret gating the app, so a stranger with the link cannot dial anyone.
APP_SHARED_SECRET=

# --- People search (Module B) ---
# pdl | fixture
PEOPLE_SEARCH_PROVIDER=fixture
PDL_API_KEY=

# --- LLM ---
GEMINI_API_KEY=

# --- Messaging ---
# logged | twilio_whatsapp
NOTIFICATION_CHANNEL=logged
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
